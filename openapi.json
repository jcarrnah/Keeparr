          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Keyword search over message + source" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 1000 }, "description": "Default 300; up to 1000 (the full retained log)" }
        ],
        "responses": { "200": { "description": "`{logs: [{ts,level,source,message}]}`" } }
      },
      "delete": {
        "tags": ["admin"],
        "summary": "Clear the event log",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/admin/scheduled-deletions": {
      "get": {
        "tags": ["admin"],
        "summary": "FORK: list scheduled-deletion tags (live first, soonest first) — the permanent deletion audit trail",
        "responses": { "200": { "description": "`{items[], summary, reclaim, residueItems[], enabled}` — each item: ratingKey, title, sizeBytes, taggedBy(+Name), taggedAt, deleteAfter, status (pending|held|deleted|failed|cancelled), statusDetail, kept, removed, verifiedAt, residueBytes (null = the disk couldn't be checked, NOT \"nothing left\"). `summary` is {count, bytes} per status; `reclaim` reports MEASURED freed bytes across verified deletions only (claimedBytes, verifiedClaimedBytes, residueBytes, verifiedCount, unverifiedCount); `residueItems` lists deletions that reported success but left bytes behind. Nothing prunes these rows — `logs` (1000) and `job_runs` (100) do, so this is the only durable record of a purge." } }
      },
      "post": {
        "tags": ["admin"],
        "summary": "FORK: tag an item \"delete after date\" (held immediately if anyone keeps it)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" }, "graceDays": { "type": "integer", "description": "Override the configured grace period for this tag" } }, "required": ["ratingKey"] } } } },
        "responses": { "200": { "description": "`{ok, deleteAfter}`" }, "404": { "description": "Unknown or tombstoned item" } }
      },
      "delete": {
        "tags": ["admin"],
        "summary": "FORK: cancel a live tag (row kept for audit)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": { "200": { "description": "`{ok}`" }, "404": { "description": "No live tag on that item" } }
      }
    },
    "/api/admin/deletion-rules": {
      "get": {
        "tags": ["admin"],
        "summary": "FORK: list auto-tag rules",
        "responses": { "200": { "description": "`{rules[]}` — id, name, enabled, conditions[], graceDays" } }
      },
      "post": {
        "tags": ["admin"],
        "summary": "FORK: create a rule",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "conditions": { "type": "array", "description": "RuleCondition[]: {field: last_watched_any|added_at|size|library|requested, op, value} AND'd together" }, "enabled": { "type": "boolean" }, "graceDays": { "type": "integer", "nullable": true } }, "required": ["name", "conditions"] } } } },
        "responses": { "200": { "description": "`{ok, id}`" }, "400": { "description": "Invalid name/conditions" } }
      },
      "put": {
        "tags": ["admin"],
        "summary": "FORK: update a rule (full replace; body adds {id})",
        "responses": { "200": { "description": "`{ok}`" } }
      },
      "delete": {
        "tags": ["admin"],
        "summary": "FORK: delete a rule (cancels its live pending/held tags)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "integer" } }, "required": ["id"] } } } },
        "responses": { "200": { "description": "`{ok, cancelledTags}`" } }
      }
    },
    "/api/admin/deletion-rules/preview": {
      "post": {
        "tags": ["admin"],
        "summary": "FORK: preview what a rule's conditions would tag right now",
        "description": "Conditions are validated exactly as a save would validate them (400 otherwise). `minVoters` is the quorum in force (null when the rule reads no opinions) and `heldByQuorum` counts titles that matched the conditions but lacked it.",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "conditions": { "type": "array" } }, "required": ["conditions"] } } } },
        "responses": { "200": { "description": "`{count, totalBytes, sample[], minVoters, heldByQuorum}`" } }
      }
    },
    "/api/admin/cache": {
      "get": {
        "tags": ["admin"],
