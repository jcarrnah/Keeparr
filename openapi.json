        "summary": "Servers visible to the signed-in Plex account",
        "responses": { "200": { "description": "`{servers[]}`" } }
      }
    },
    "/api/admin/storage-check": {
      "get": {
        "tags": ["admin"],
        "summary": "Validate a storage mapping path",
        "parameters": [{ "name": "path", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "`{ok, freeBytes?, totalBytes?}`" } }
      }
    },
    "/api/admin/arr-health": {
      "get": {
        "tags": ["admin"],
        "summary": "Sonarr/Radarr match health",
        "responses": { "200": { "description": "`{matched, unmatched[], missing, arrJob}` — unmatched = downloaded in *arr but not in the media server, largest first" } }
      }
    },
    "/api/admin/problems/summary": {
      "get": {
        "tags": ["admin"],
        "summary": "Problems page pill strip: per-category counts + bytes",
        "responses": { "200": { "description": "`{arrConfigured, serverType, categories[]}` — one `{type, available, reason?, titles, bytes}` per category in display order; arr-gated categories come back `available:false` (zeroed) without Sonarr/Radarr, `notInArr` also waits for the first successful arr match, and `diskOrphans` needs storage mappings + a completed Disk scan run (until then `reason` is `storage_not_configured` or `not_scanned`). `serverType` (plex|jellyfin|emby) lets clients name the media server in labels." } }
      }
    },
    "/api/admin/problem-actions": {
      "post": {
        "tags": ["admin"],
        "summary": "FORK: run a fix-it action from the Problems page",
        "description": "Non-destructive repairs, kept on a separate path from the `/api/admin/problems` reads. `relink` carries keeps/skips/verdicts/watch history from a tombstoned item onto the live copy that replaced it (a re-added title gets a NEW rating_key, which otherwise strands the keep and leaves the live copy unprotected) — the on-demand version of what the nightly library sweep does. `rescan` asks Jellyfin/Emby to refresh so entries whose files are gone drop out. Neither deletes media nor touches the filesystem.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "type": "string", "enum": ["relink", "rescan"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "`{ok:true, message, changed}` — `changed` is the number of items re-linked (or 1/0 for whether a rescan started); `message` is display-ready." },
          "400": { "description": "`bad_request` — unknown action" },
          "403": { "description": "Not an admin" }
        }
      }
    },
    "/api/admin/problems": {
      "get": {
        "tags": ["admin"],
        "summary": "Paged list for one problem category",
        "parameters": [
          { "name": "type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["sizeMismatch", "notInArr", "missingFromPlex", "identityMismatch", "duplicates", "arrConflicts", "zeroSize", "removedButKept", "missingIds", "diskOrphans"] } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "includeMissingIds", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "`notInArr` only: also list titles with no external id (hidden by default — they can never match *arr and have their own missingIds category)" },
          { "name": "sort", "in": "query", "schema": { "type": "string" }, "description": "Per-category allow-list (e.g. `title`, `size`, `added`, `delta`, `arrSize`, `instance`, `name`); unknown/absent = the category's default order" },
          { "name": "dir", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "sections", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated library ids; filters categories whose rows are media items" },
          { "name": "kind", "in": "query", "schema": { "type": "string", "enum": ["movie", "show"] } }
        ],
        "responses": {
          "200": { "description": "`{type, items[], hasMore, nextOffset}` — item shape varies per category (`duplicates` items are groups with members; `identityMismatch` items pair `{media, arr}` claims on one folder; `diskOrphans` items are filesystem entries with `likely` = the library title the orphan looks like). Media-item rows carry `dirPath` (full server-side folder path; `path` on missingFromPlex). Diagnosis fields: `sizeMismatch` rows carry `diskSizeBytes/diskCheckedAt` (measured on-disk tiebreaker) + `fileCount` (movies; >1 = the server merged several files into the item, so the mismatch is by design); `missingFromPlex` rows carry `onDisk/diskSizeBytes` (null until verified) + `claimedByTitle`; `notInArr` rows carry `identityArrTitle` (both cross-link the row to its identity-mismatch pair); `identityMismatch` media sides carry their own `guidTmdb/guidTvdb/guidImdb`; `arrConflicts` rows carry `sameInstance` (true = two titles of one instance resolve to one item — a merged multi-part entry; split it apart in the server) plus `instanceId` on winner/loser; `zeroSize` rows carry `arrBytes/instanceName`. Zero-size items are excluded from `sizeMismatch` (they diagnose under `zeroSize`)." },
          "400": { "description": "`unknown_type` (missing/unknown type — no default view), `arr_not_configured` (arr-gated type without Sonarr/Radarr), or `storage_not_configured` (`diskOrphans` without storage mappings)" }
        }
      }
    }
  }
}
