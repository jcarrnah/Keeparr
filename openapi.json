{
  "openapi": "3.0.3",
  "info": {
    "title": "Keeparr API",
    "version": "0.3.25",
    "description": "Keeparr tags what to keep and reports what can be deleted — it never deletes anything itself.\n\n**Authentication**: most endpoints use the `keeparr_session` cookie (set by logging in through the web UI). Endpoints marked with `X-Api-Key` security also accept the admin API key (Settings → General) in the `X-Api-Key` header — intended for automation (`/api/stats`, `/api/admin/jobs`).\n\nAll ids (`ratingKey`) are the media server's item ids (Plex ratingKey or Jellyfin/Emby item id)."
  },
  "servers": [{ "url": "/", "description": "This Keeparr instance" }],
  "tags": [
    { "name": "auth", "description": "Login/session (backend-aware: Plex PIN or Jellyfin/Emby credentials)" },
    { "name": "media", "description": "Feed, browse, search, decisions (keep / don't care / OK to delete)" },
    { "name": "insights", "description": "Overview, stats, storage" },
    { "name": "admin", "description": "Admin-only: settings, jobs, users, logs, backups, health" },
    { "name": "automation", "description": "Endpoints that also accept the X-Api-Key header" }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "keeparr_session",
        "description": "Signed session cookie set by the web login."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Admin API key from Settings → General."
      }
    },
    "schemas": {
      "MediaCard": {
        "type": "object",
        "description": "One movie/series card. Arr fields are null/absent when the title isn't matched in Sonarr/Radarr.",
        "properties": {
          "ratingKey": { "type": "string" },
          "title": { "type": "string" },
          "year": { "type": "integer", "nullable": true },
          "sizeBytes": { "type": "integer" },
          "sizeLabel": { "type": "string" },
          "thumbUrl": { "type": "string", "nullable": true },
          "libraryKind": { "type": "string", "enum": ["movie", "show"] },
          "kept": { "type": "boolean", "description": "Protected — kept by anyone" },
          "keptByMe": { "type": "boolean" },
          "skipped": { "type": "boolean", "description": "This user's \"don't care\"" },
          "watched": { "type": "boolean" },
          "requestedByMe": { "type": "boolean" },
          "markedForDeleteByMe": { "type": "boolean" },
          "markedForDeleteAny": { "type": "boolean" },
          "source": { "type": "string", "enum": ["sonarr", "radarr"] },
          "quality": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "overview": { "type": "string", "description": "Plot synopsis from the media server (absent until synced)" },
          "genres": { "type": "array", "items": { "type": "string" } },
          "runtimeMinutes": { "type": "integer", "description": "Runtime in whole minutes" },
          "verdictScore": { "type": "integer", "description": "FORK: the household's weighted verdict score (positive = they want it gone). Absent when nobody has voted — which is not the same as a score of 0." },
          "verdictVoters": { "type": "integer", "description": "FORK: how many people fed verdictScore (swipes plus the keeps / \"don't care\" / \"OK to delete\" they stand in for)." }
        }
      },
      "RoomMember": {
        "type": "object",
        "description": "FORK: a participant in a live swipe room.",
        "properties": {
          "plexUserId": { "type": "string" },
          "username": { "type": "string", "nullable": true },
          "active": { "type": "boolean", "description": "Within the presence window (actively polling)" },
          "votes": { "type": "integer", "description": "Titles this member has swiped" },
          "isMe": { "type": "boolean" }
        }
      },
      "RoomState": {
        "type": "object",
        "description": "FORK: full state of a live movie-night room.",
        "properties": {
          "code": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "matched", "closed"] },
          "isHost": { "type": "boolean" },
          "sectionId": { "type": "string", "nullable": true },
          "watchMode": { "type": "string", "nullable": true },
          "activeCount": { "type": "integer" },
          "members": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } },
          "matched": { "allOf": [{ "$ref": "#/components/schemas/MediaCard" }], "nullable": true, "description": "The agreed title once status = matched" }
        }
      },
      "HealthIssue": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["warning", "error"] },
          "message": { "type": "string" },
          "docSlug": { "type": "string", "description": "README anchor with the fix" }
        }
      },
      "JobState": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string" },
          "label": { "type": "string" },
          "lastStatus": { "type": "string", "enum": ["never", "running", "ok", "error"] },
          "lastRun": { "type": "integer", "nullable": true },
          "lastMessage": { "type": "string", "nullable": true },
          "lastDurationMs": { "type": "integer", "nullable": true },
          "schedule": { "type": "object" }
        }
      },
      "Backup": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "keeparr-20260706-080000.db" },
          "sizeBytes": { "type": "integer" },
          "createdAt": { "type": "integer", "description": "Unix seconds" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  },
  "security": [{ "cookieAuth": [] }],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["automation"],
        "summary": "Liveness probe (public)",
        "security": [],
        "responses": { "200": { "description": "`{ok:true}`" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Current session user + app title",
        "responses": { "200": { "description": "`{user, appTitle, serverConfigured}` (user is null when signed out)" } }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Clear the session cookie (this device)",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/auth/logout-all": {
      "post": {
        "tags": ["auth"],
        "summary": "Sign out all devices: bump the user's session epoch (invalidate every token) and clear this cookie",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/auth/plex/pin": {
      "post": {
        "tags": ["auth"],
        "summary": "Start a Plex PIN login (Plex backend only)",
        "security": [],
        "responses": { "200": { "description": "`{id, authUrl}` — open authUrl, then poll check" } }
      }
    },
    "/api/auth/plex/check": {
      "get": {
        "tags": ["auth"],
        "summary": "Poll a Plex PIN",
        "security": [],
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "`{status: pending|authorized|denied, needsSetup?, isAdmin?}`" } }
      }
    },
    "/api/auth/setup": {
      "post": {
        "tags": ["auth"],
        "summary": "First-run only: choose the media-server type (and URL for Jellyfin/Emby)",
        "security": [],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "type": { "type": "string", "enum": ["plex", "jellyfin", "emby"] }, "url": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Recorded" },
          "403": { "description": "An admin already exists" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Jellyfin/Emby credential login",
        "security": [],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "username": { "type": "string" }, "password": { "type": "string" } }, "required": ["username", "password"] } } } },
        "responses": { "200": { "description": "Session cookie set" }, "401": { "description": "Bad credentials" } }
      }
    },
    "/api/feed/random": {
      "get": {
        "tags": ["media"],
        "summary": "Home keep-loop batch",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "section", "in": "query", "schema": { "type": "string" }, "description": "Limit to one library" },
          { "name": "largest", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "Biggest titles regardless of eligibility" },
          { "name": "watch", "in": "query", "schema": { "type": "string", "enum": ["never_played", "stale_90", "recent_30", "my_unwatched"] }, "description": "Restrict to a watch-history list (never_played/stale_90/recent_30 = anyone's history; my_unwatched = this user's). Ignored with largest=1" }
        ],
        "responses": { "200": { "description": "`{items: MediaCard[], remaining}`" } }
      }
    },
    "/api/swipe/deck": {
      "get": {
        "tags": ["media"],
        "summary": "FORK: swipe deck — movies + whole series this user hasn't sworn a verdict on",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "section", "in": "query", "schema": { "type": "string" }, "description": "Limit to one library" },
          { "name": "watch", "in": "query", "schema": { "type": "string", "enum": ["never_played", "stale_90", "recent_30", "my_unwatched"] }, "description": "Same watch-history lists as the feed" }
        ],
        "responses": { "200": { "description": "`{items: MediaCard[], remaining}`" } }
      }
    },
    "/api/swipe/verdict": {
      "post": {
        "tags": ["media"],
        "summary": "FORK: record a swipe verdict (write-through to keeps/skips)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" }, "verdict": { "type": "string", "enum": ["want_to_watch", "loved_it", "done_with_it", "not_interested", "dont_care"] } }, "required": ["ratingKey", "verdict"] } } } },
        "responses": { "200": { "description": "`{ok}`" }, "404": { "description": "Unknown or tombstoned item" } }
      },
      "delete": {
        "tags": ["media"],
        "summary": "FORK: undo a verdict (reverses its keep/skip side effects)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": { "200": { "description": "`{ok, removed}`" }, "404": { "description": "No verdict to undo" } }
      }
    },
    "/api/swipe/rooms": {
      "post": {
        "tags": ["media"],
        "summary": "FORK: create a live movie-night room (host auto-joins)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "section": { "type": "string" }, "watch": { "type": "string", "enum": ["never_played", "stale_90", "recent_30"] } } } } } },
        "responses": { "200": { "description": "`{code, state: RoomState}`" } }
      }
    },
    "/api/swipe/rooms/{code}": {
      "get": {
        "tags": ["media"],
        "summary": "FORK: poll a room (~2s heartbeat — bumps presence, re-checks consensus)",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "`{state: RoomState}`" },
          "403": { "description": "not_in_room" },
          "404": { "description": "room_not_found" }
        }
      }
    },
    "/api/swipe/rooms/{code}/join": {
      "post": {
        "tags": ["media"],
        "summary": "FORK: join a room by code",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "`{state: RoomState}`" }, "404": { "description": "room_not_found" }, "409": { "description": "room_closed" } }
      }
    },
    "/api/swipe/rooms/{code}/deck": {
      "get": {
        "tags": ["media"],
        "summary": "FORK: this viewer's slice of the shared room deck",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "`{items: MediaCard[], remaining}`" } }
      }
    },
    "/api/swipe/rooms/{code}/vote": {
      "post": {
        "tags": ["media"],
        "summary": "FORK: cast a want/pass vote (a match lands once everyone present wants the same title)",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" }, "want": { "type": "boolean" } }, "required": ["ratingKey", "want"] } } } },
        "responses": { "200": { "description": "`{state: RoomState}` (carries matched card once agreed)" }, "404": { "description": "room_not_found / unknown_item" } }
      }
    },
    "/api/swipe/rooms/{code}/leave": {
      "post": {
        "tags": ["media"],
        "summary": "FORK: leave a room (host leaving an open room closes it)",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "`{ok}`" } }
      }
    },
    "/api/swipe/matches": {
      "get": {
        "tags": ["media"],
        "summary": "FORK: movie-night matches — titles ≥2 chosen users saved for later (names shown by design)",
        "parameters": [
          { "name": "users", "in": "query", "schema": { "type": "string" }, "description": "Comma list of user ids to match between (omit = all participants)" },
          { "name": "unwatched", "in": "query", "schema": { "type": "string", "enum": ["1"] }, "description": "Only titles nobody on the server has watched" }
        ],
        "responses": { "200": { "description": "`{items: [{…card, wantCount, wanterIds[], wanterNames[]}], users[], me}`" } }
      }
    },
    "/api/swipe/consensus": {
      "get": {
        "tags": ["media"],
        "summary": "FORK: per-item verdict rollup (who wants / keeps / released each title)",
        "parameters": [
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["votes", "size", "score"] }, "description": "votes = most delete votes first (default); score = most wanted gone first (weighted)" },
          { "name": "voter", "in": "query", "schema": { "type": "string" }, "description": "FORK: only titles this user has an opinion on (explicit or implied)" },
          { "name": "verdict", "in": "query", "schema": { "type": "string", "enum": ["not_interested", "done_with_it", "dont_care", "want_to_watch", "loved_it"] }, "description": "FORK: only titles marked this way; combine with voter for \"everything X let go\"" },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "`{items: [{…card, kept, wantNames[], keepNames[], doneNames[], neverNames[], skipCount, deleteVotes, score, voters, keepImplicitNames[], doneImplicitNames[], skipImplicitCount}], me, voters: [{id, username}], hasMore, nextOffset}` — `score` sums the verdict scale across everyone (let it go +2, wouldn't be mad +1, skip 0, save for later −1, worth keeping −2); a keep / don't-care / OK-to-delete made outside Swipe counts as an implied vote, listed separately in the `*Implicit*` fields" } }
      }
    },
    "/api/keep": {
      "post": {
        "tags": ["media"],
        "summary": "Keep a title (this user). Clears their don't-care + OK-to-delete atomically.",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "`{error:'unknown_item'}` — unknown or removed from the server" }
        }
      },
      "delete": {
        "tags": ["media"],
        "summary": "Remove this user's keep (others' keeps stay)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/skip": {
      "post": {
        "tags": ["media"],
        "summary": "Mark \"don't care\" (this user). Clears their keep + OK-to-delete atomically.",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "`{error:'unknown_item'}` — unknown or removed from the server" }
        }
      },
      "delete": {
        "tags": ["media"],
        "summary": "Clear this user's \"don't care\"",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/mark-delete": {
      "post": {
        "tags": ["media"],
        "summary": "Mark \"OK to delete\" — only on titles this user requested via Seerr",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": {
          "200": { "description": "OK" },
          "403": { "description": "`{error:'not_requested'}` — not this user's request" },
          "404": { "description": "`{error:'unknown_item'}` — unknown or removed from the server" }
        }
      },
      "delete": {
        "tags": ["media"],
        "summary": "Clear this user's \"OK to delete\"",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKey": { "type": "string" } }, "required": ["ratingKey"] } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/skip-batch": {
      "post": {
        "tags": ["media"],
        "summary": "Skip a batch (\"don't care\" all) and deal a fresh one",
        "description": "Skipping clears this user's keep / OK-to-delete on the batch (mutually exclusive). Unknown/tombstoned keys are ignored. Max 500 keys.",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "ratingKeys": { "type": "array", "items": { "type": "string" }, "maxItems": 500 } } } } } },
        "responses": {
          "200": { "description": "`{items: MediaCard[], remaining}`" },
          "400": { "description": "`{error:'bad_request'}` (not an array) or `{error:'too_many_items'}` (over 500)" }
        }
      }
    },
    "/api/library": {
      "get": {
        "tags": ["media"],
        "summary": "Browse/filter the library",
        "description": "Filters compose. `state` is the combinable Status filter: a comma list of per-user decision buckets OR'd together (empty = all). Arr filters (`source`, `instance`, `tag`, `quality`, `status`, `monitored`) are comma-separated \"any of\" lists.",
        "parameters": [
          { "name": "sections", "in": "query", "schema": { "type": "string" }, "description": "Comma list of library ids (empty = all)" },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["size", "title", "added", "year", "library", "quality", "tags", "status", "watched", "score"] }, "description": "`score` (FORK) = the household's weighted verdict score; un-voted titles sort last in both directions" },
          { "name": "dir", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "state", "in": "query", "schema": { "type": "string" }, "description": "Comma list of: keptByMe, keptOther, dontcare, okDeleteMine, okDeleteAny, undecided, scheduledDeletion (FORK)" },
          { "name": "watch", "in": "query", "schema": { "type": "string", "enum": ["all", "watched", "unwatched", "unwatchedAny", "recent30", "recent60", "recent90", "stale90"] } },
          { "name": "source", "in": "query", "schema": { "type": "string" } },
          { "name": "instance", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "quality", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "monitored", "in": "query", "schema": { "type": "string" } },
          { "name": "match", "in": "query", "schema": { "type": "string", "enum": ["matched", "unmatched"] } },
          { "name": "sizeMismatch", "in": "query", "schema": { "type": "string", "enum": ["1"] } },
          { "name": "requestedByMe", "in": "query", "schema": { "type": "string", "enum": ["1"] } },
          { "name": "minScore", "in": "query", "schema": { "type": "integer" }, "description": "FORK: only titles the household scores at least this high (an un-voted title counts as 0). Non-numeric = no threshold." },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "One page of results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/MediaCard" } },
                    "hasMore": { "type": "boolean" },
                    "nextOffset": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/library/facets": {
      "get": {
        "tags": ["media"],
        "summary": "Values for the Browse arr filter dropdowns",
        "responses": { "200": { "description": "`{instances, tags, qualities, statuses}`" } }
      }
    },
    "/api/search": {
      "get": {
        "tags": ["media"],
        "summary": "Ranked title search",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "`{items: MediaCard[], hasMore, nextOffset}`" } }
      }
    },
    "/api/search/suggest": {
      "get": {
        "tags": ["media"],
        "summary": "Top-8 typeahead",
        "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "`{suggestions: [{ratingKey,title,year,thumbUrl,kept,skipped}]}`" } }
      }
    },
    "/api/sections": {
      "get": {
        "tags": ["media"],
        "summary": "Managed libraries",
        "responses": { "200": { "description": "`{sections: [{id,title,kind,itemCount,sizeBytes}]}`" } }
      }
    },
    "/api/requests": {
      "get": {
        "tags": ["media"],
        "summary": "This user's cached Seerr request keys",
        "responses": { "200": { "description": "`{ratingKeys: string[]}`" } }
      }
    },
    "/api/image": {
      "get": {
        "tags": ["media"],
        "summary": "Poster proxy (token stays server-side)",
        "parameters": [
          { "name": "path", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "w", "in": "query", "schema": { "type": "integer" } },
          { "name": "h", "in": "query", "schema": { "type": "integer" } }
        ],
